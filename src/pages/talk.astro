---
import BaseLayout from '../layouts/BaseLayout.astro';
import FicPost from '../components/FicPost.astro';
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const pageTitle = "tea talk";
---

<BaseLayout pageTitle={pageTitle}>
        <p>This is where I'll talk about little writing things -- inspiration etc.</p>

    <ul>
    {allPosts.map((post: any) => <FicPost url={post.url} title={post.frontmatter.title} />)}
    </ul>
</BaseLayout>